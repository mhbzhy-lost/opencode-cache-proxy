# Upstream API key. Required.
OPENAI_COMPATIBLE_API_KEY=sk-xxxx

# Upstream OpenAI-compatible base URL. Default: https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPATIBLE_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Cache marker placement strategy. Default: turn-stable
# turn-stable: anchors mid-markers at user turn boundaries (stable within a turn,
#              best hit rate for coding agents with multi-tool-call turns)
# fraction:    places markers at token-fraction positions [0.5, 0.85] (legacy)
# BAILIAN_CACHE_PROXY_MARKER_STRATEGY=turn-stable
