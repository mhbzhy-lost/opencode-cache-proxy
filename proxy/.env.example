# Generic OpenAI-compatible API key fallback. Client Authorization headers win.
OPENAI_COMPATIBLE_API_KEY=sk-xxxx

# DashScope-compatible aliases are still supported for existing installs.
# DASHSCOPE_API_KEY=sk-xxxx

# Alibaba Cloud Coding Plan API key. Use this when BAILIAN_UPSTREAM_BASE_URL
# points at https://coding.dashscope.aliyuncs.com/v1.
# BAILIAN_CODING_PLAN_API_KEY=sk-sp-xxxx

# Optional overrides (defaults shown after =).

# Local proxy listen port.
# BAILIAN_CACHE_PROXY_PORT=48761

# Upstream OpenAI-compatible base URL.
# OPENAI_COMPATIBLE_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# Historical DashScope/Bailian aliases are still supported:
# BAILIAN_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# For Alibaba Cloud Coding Plan:
# BAILIAN_UPSTREAM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# Minimum estimated prefix tokens before adding cache markers.
# BAILIAN_CACHE_PROXY_MIN_TOKENS=1024

# Deprecated; marker placement is token-fraction based now.
# BAILIAN_CACHE_PROXY_MAX_LOOKBACK_BLOCKS=20

# Maximum accepted request body size in bytes.
# BAILIAN_CACHE_PROXY_MAX_BODY_BYTES=10485760

# Set to 0 to disable plugin-managed proxy startup.
# OPENCODE_BAILIAN_CACHE_PROXY=0

# Set to 0 to disable Qwen hook-managed proxy startup.
# QWEN_BAILIAN_CACHE_PROXY=0

# Maximum accepted Qwen hook JSON input size.
# QWEN_BAILIAN_CACHE_PROXY_MAX_STDIN_BYTES=65536
